# PostgreSQL. Quick local DB:
#   docker run -d --name content_planner_db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=content_planner -p 5434:5432 postgres:16-alpine
DATABASE_URL="postgresql://postgres:postgres@localhost:5434/content_planner"

# Random secret for login sessions: openssl rand -hex 32
SESSION_SECRET=""

# Public base URL of the app. Facebook/Instagram download post images from APP_URL/media/...,
# so to publish images this must be a public HTTPS address (in development: an ngrok tunnel).
APP_URL="http://localhost:3000"

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# GEMINI_TEXT_MODEL="gemini-3.5-flash"   # fast; gemini-3.8-flash is stronger but often overloaded on the free tier
# GEMINI_IMAGE_MODEL="gemini-3.1-flash-image"   # image models need billing enabled (free tier quota is 0)

# Meta app (developers.facebook.com). Redirect URI: $APP_URL/api/meta/callback
META_APP_ID=""
META_APP_SECRET=""
# Facebook Login for Business > Configurations > your configuration's ID
META_CONFIG_ID=""
# META_GRAPH_VERSION="v25.0"

# Protects /api/cron, for hosts without a long-running server: openssl rand -hex 16
CRON_SECRET=""
# DISABLE_SCHEDULER="1"   # turn off the built-in background scheduler
1501191318498150
