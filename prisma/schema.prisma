generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String           @id @default(cuid())
  email        String           @unique
  name         String
  passwordHash String
  createdAt    DateTime         @default(now())
  brands       Brand[]
  meta         MetaConnection?
  campaigns    Campaign[]
  posts        Post[]
  reports      StrategyReport[]
  apiTokens    ApiToken[]
}

/// One brand per Facebook Page: its own profile, content, analytics, strategy and autopilot
model Brand {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name         String
  industry     String
  description  String
  audience     String
  tone         String
  offerings    String
  goals        String
  website      String?
  language     String   @default("English")
  visualStyle  String   @default("Clean, modern, bright natural light")
  postsPerWeek Int      @default(4)
  /// When on, the scheduler plans next week's posts and schedules them without approval
  autopilot    Boolean  @default(false)
  timezone     String   @default("UTC")
  /// The Facebook Page (and its linked Instagram account) this brand publishes to
  pageId          String?
  pageName        String?
  pageAccessToken String?
  igUserId        String?
  igUsername      String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  campaigns    Campaign[]
  posts        Post[]
  reports      StrategyReport[]

  @@unique([userId, pageId])
}

model MetaConnection {
  id              String    @id @default(cuid())
  userId          String    @unique
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userAccessToken String
  tokenExpiresAt  DateTime?
  /// Pages returned by /me/accounts; brands link to them by id
  availablePages  Json
  connectedAt     DateTime  @default(now())
}

model Campaign {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  name      String
  brief     String
  createdAt DateTime @default(now())
  posts     Post[]
}

enum Platform {
  FACEBOOK
  INSTAGRAM
}

enum Pillar {
  EDUCATIONAL
  PROMOTIONAL
  ENGAGEMENT
  BEHIND_THE_SCENES
  SOCIAL_PROOF
  INSPIRATIONAL
}

enum ImageState {
  NONE
  PENDING
  GENERATING
  READY
  FAILED
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHING
  PUBLISHED
  FAILED
}

model Post {
  id               String     @id @default(cuid())
  userId           String
  user             User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId          String
  brand            Brand      @relation(fields: [brandId], references: [id], onDelete: Cascade)
  campaignId       String?
  campaign         Campaign?  @relation(fields: [campaignId], references: [id], onDelete: SetNull)
  platform         Platform
  pillar           Pillar
  hook             String
  caption          String
  hashtags         String[]
  imagePrompt      String
  imageFile        String?
  imageState       ImageState @default(NONE)
  status           PostStatus @default(DRAFT)
  scheduledAt      DateTime?
  publishedAt      DateTime?
  externalId       String?
  permalink        String?
  error            String?
  reach            Int?
  views            Int?
  likes            Int?
  comments         Int?
  shares           Int?
  saves            Int?
  interactions     Int?
  metricsUpdatedAt DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  @@index([brandId, status])
  @@index([status, scheduledAt])
}

model StrategyReport {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  brandId   String
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  /// Structured output from the strategist model (see lib/ai/strategy.ts)
  report    Json
  postCount Int
  createdAt DateTime @default(now())
}

/// Personal access tokens for the MCP endpoint (/api/mcp). Only the SHA-256 hash is stored.
model ApiToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  tokenHash  String    @unique
  /// First characters of the token, shown so the user can tell tokens apart
  prefix     String
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())
}
